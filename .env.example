# Notion internal integration token (Settings > Connections > Develop or manage integrations)
NOTION_TOKEN=secret_xxx

# The Apply log data source id (collection id). Found in the Notion MCP fetch output as
# collection://<id>, or via GET /v1/databases/<database_id> with Notion-Version 2025-09-03.
NOTION_DATA_SOURCE_ID=2909dfcb-954c-482f-ad12-b1bc752572ea

# Passphrase for the private detail view. Anyone with this can decrypt the row-level data.
PRIVATE_PASSPHRASE=change-me

# Optional: override the GitHub Pages base path (default /job-hunt/). Use "/" for a custom domain.
# VITE_BASE=/job-hunt/
